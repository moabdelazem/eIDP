DATABASE_URL=postgresql://eidp:eidp@localhost:5432/eidp
LDAP_URL=ldap://localhost:389
LDAP_BIND_DN=cn=admin,dc=eidp,dc=local
LDAP_BIND_PASSWORD=admin
LDAP_BASE_DN=dc=eidp,dc=local
JWT_SECRET=dev-secret-change-me

# Azure DevOps Server (on-prem). ADO_BASE_URL includes the collection.
ADO_BASE_URL=https://tfs.example.com/tfs/DefaultCollection
ADO_PAT=
ADO_API_VERSION=6.0
INVENTORIES_PROJECT=
INVENTORIES_REPO=inventories

# How an account is recognised. Run `pnpm --filter @eidp/api ldap:doctor <user>`
# to have the directory tell you which of these it needs.
#   OpenLDAP / 389-ds / Oracle DSEE:  inetOrgPerson + uid
#   Active Directory:                 use LDAP_USER_FILTER below instead
LDAP_USER_OBJECT_CLASS=inetOrgPerson
LDAP_USER_ATTRIBUTE=uid
# Overrides the two above. {username} is substituted, already escaped.
# Active Directory:
# LDAP_USER_FILTER=(&(objectCategory=person)(objectClass=user)(sAMAccountName={username}))
