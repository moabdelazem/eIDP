# Copy to .env and fill in. `pnpm dev` and scripts/dev.sh do the copy for you.

PORT=3000
JWT_SECRET=dev-secret-change-me
SESSION_TTL_HOURS=8

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://eidp:eidp@localhost:5432/eidp
SYNC_INTERVAL_MINUTES=30

# ---------------------------------------------------------------------------
# Directory — Active Directory
#
# Run `pnpm --filter @eidp/api ldap:doctor <username> <password>` after
# filling these in; it reports which stage fails and prints the base DN the
# server actually serves.
# ---------------------------------------------------------------------------

# Use ldaps://<host>:636 where the domain requires TLS for simple binds.
LDAP_URL=ldap://dc01.example.com:389

# The suffix to search under. `ldap:doctor` lists what the server serves;
# it is normally the domain, e.g. dc=example,dc=com.
LDAP_BASE_DN=dc=example,dc=com

# The service account the portal searches as. AD accepts any of:
#   user@example.com                     (userPrincipalName — simplest)
#   EXAMPLE\svc-eidp                     (down-level logon name)
#   cn=svc-eidp,ou=Service,dc=example,dc=com
# It only needs read access to the user subtree.
LDAP_BIND_DN=svc-eidp@example.com
LDAP_BIND_PASSWORD=

# How an account is found. objectCategory=person matters: in AD a computer
# account is also objectClass=user, so without it a machine can match.
# {username} is substituted after escaping.
LDAP_USER_FILTER=(&(objectCategory=person)(objectClass=user)(sAMAccountName={username}))

# Which groups an account is in. Optional: left out, the API asks the server
# what it is and uses this for Active Directory. The in-chain rule
# (1.2.840.113556.1.4.1941) also follows nested groups: someone in a team that
# is itself inside DEVOPS still counts, where plain memberOf would miss them.
# {dn} is substituted, escaped.
LDAP_GROUP_FILTER=(&(objectClass=group)(member:1.2.840.113556.1.4.1941:={dn}))

# Members of this AD group decide requests, and nobody else can.
APPROVER_GROUP=DEVOPS

# Ignored while LDAP_USER_FILTER is set. Used by directories that need only a
# class and an attribute — OpenLDAP, 389-ds and Oracle DSEE want
# inetOrgPerson + uid.
LDAP_USER_OBJECT_CLASS=user
LDAP_USER_ATTRIBUTE=sAMAccountName

# ---------------------------------------------------------------------------
# Azure DevOps Server (on-prem) — where the inventories repo lives
# ---------------------------------------------------------------------------
# ADO_BASE_URL is the server plus the default collection. Other collections
# are discovered from the server root above it, for the request forms.
# Set ADO_SERVER_URL only if the server is not simply ADO_BASE_URL minus its
# last segment.
ADO_BASE_URL=https://tfs.example.com/tfs/DefaultCollection
# ADO_SERVER_URL=https://tfs.example.com/tfs
# The PAT needs Code (read & write) to create repositories, and Project and
# Team (read, write & manage) to create projects.
ADO_PAT=
ADO_API_VERSION=6.0
INVENTORIES_PROJECT=
INVENTORIES_REPO=inventories

# ---------------------------------------------------------------------------
# Jira Data Center / Server (on-prem) — for Jira project requests
# ---------------------------------------------------------------------------
# JIRA_TOKEN is a personal access token of a service account with the
# Administer global permission (creating projects needs it). Set JIRA_USERNAME
# only on servers older than 8.14, which have no PATs: the token is then sent
# as that account's password.
JIRA_BASE_URL=
JIRA_TOKEN=
# JIRA_USERNAME=
# New projects are made from this template. Kanban is
# com.pyxis.greenhopper.jira:gh-simplified-kanban-classic.
# JIRA_PROJECT_TEMPLATE=com.pyxis.greenhopper.jira:gh-simplified-scrum-classic
# The project role the requester and their team are put in.
# JIRA_MEMBER_ROLE=Developers

# ---------------------------------------------------------------------------
# Jenkins — for the Jenkins page
# ---------------------------------------------------------------------------
# JENKINS_TOKEN is an API token of JENKINS_USER (Jenkins → the user → Security
# → API Token), not their password. The account needs Overall/Read and Job/Read
# to see, and Job/Build and Job/Cancel for the page's actions.
JENKINS_URL=
JENKINS_USER=
JENKINS_TOKEN=
# Build history is copied into the portal's database for the 24h/7d dashboard
# and parameter search: read every JENKINS_SYNC_SECONDS (0 turns the timer
# off; Refresh still works), kept JENKINS_RETENTION_DAYS.
# JENKINS_SYNC_SECONDS=60
# JENKINS_RETENTION_DAYS=30
#
# Who may see which job is read from Jenkins' own authorization (role-based
# strategy, or matrix grants on folders and jobs) every
# JENKINS_ACCESS_SYNC_MINUTES, and decides what My pipelines shows each team.
# The service account needs to administer roles (role-based) or Job/ExtendedRead
# (matrix) to read them; without that, the catalog's team ownership is used.
# JENKINS_ACCESS_SYNC_MINUTES=15

# ---------------------------------------------------------------------------
# Ollama — the portal's AI features (explaining failed builds). Optional.
# ---------------------------------------------------------------------------
# OLLAMA_URL=http://ollama.example.com:11434
# An Ollama tag; qwen2.5 is Qwen 2.5 7B. The model must be pulled on that host.
# OLLAMA_MODEL=qwen2.5
# The context window asked for on every call. Ollama's own default is small
# and it cuts longer prompts silently; raise this if the host has the memory.
# OLLAMA_NUM_CTX=8192
# OLLAMA_TIMEOUT_SECONDS=180
# Each Jenkins job's latest failure is explained automatically after the sync
# that finds it, one at a time. false turns that off; answers are then made
# only when someone asks. Only failures from the last N hours are explained.
# OLLAMA_AUTO_EXPLAIN=true
# OLLAMA_AUTO_EXPLAIN_HOURS=24

# ---------------------------------------------------------------------------
# Offline development against the bundled OpenLDAP container instead of AD.
# Uncomment this block, and sign in as alice/alicepw or bob/bobpw.
# ---------------------------------------------------------------------------
# LDAP_URL=ldap://localhost:1389
# LDAP_BASE_DN=dc=eidp,dc=local
# LDAP_BIND_DN=cn=admin,dc=eidp,dc=local
# LDAP_BIND_PASSWORD=admin
# LDAP_USER_FILTER=
# LDAP_USER_OBJECT_CLASS=inetOrgPerson
# LDAP_USER_ATTRIBUTE=uid
# LDAP_GROUP_FILTER=(&(objectClass=groupOfNames)(member={dn}))
#
# ...and no Azure DevOps: `pnpm --filter @eidp/api ado:fake` runs a stand-in.
# ADO_BASE_URL=http://localhost:4010/tfs/DefaultCollection
# ADO_PAT=fake
#
# ...and no Jira: `pnpm --filter @eidp/api jira:fake` runs a stand-in.
# JIRA_BASE_URL=http://localhost:4020/jira
# JIRA_TOKEN=fake
#
# ...and no Jenkins: `pnpm --filter @eidp/api jenkins:fake` runs a stand-in.
# JENKINS_URL=http://localhost:4030/jenkins
# JENKINS_USER=eidp
# JENKINS_TOKEN=fake
#
# ...and no Ollama: `pnpm --filter @eidp/api ollama:fake` runs a stand-in.
# OLLAMA_URL=http://localhost:11500

# ---------------------------------------------------------------------------
# HashiCorp Vault — where the secrets above can live instead. Optional.
#
# With VAULT_ADDR set, the API reads VAULT_SECRET_PATHS (comma-separated,
# under VAULT_KV_MOUNT; a later path wins) before anything else, and every
# key there named like a setting in this file replaces it — JWT_SECRET,
# LDAP_BIND_PASSWORD, ADO_PAT, JIRA_TOKEN, JENKINS_TOKEN, DATABASE_URL, …
# Names the API does not read are ignored. If Vault cannot be read the API
# boots on this file and says why in the log (and /health reports
# "env-fallback"); VAULT_REQUIRED=true makes that a refusal to start.
#
# Log in with a token, or with AppRole (its token is revoked once read).
# A private CA: NODE_EXTRA_CA_CERTS=/path/to/ca.pem — Node's fetch has no
# per-request CA setting.
# Local stand-in: pnpm --filter @eidp/api vault:fake
# ---------------------------------------------------------------------------
# VAULT_ADDR=https://vault.example.com:8200
# VAULT_NAMESPACE=
# VAULT_TOKEN=
# VAULT_ROLE_ID=
# VAULT_SECRET_ID=
# VAULT_APPROLE_PATH=approle
# VAULT_KV_MOUNT=secret
# VAULT_KV_VERSION=2
# VAULT_SECRET_PATHS=eidp/api
# VAULT_TIMEOUT_SECONDS=5
# VAULT_REQUIRED=false
