# The UI, for production: the Vite build served by unprivileged nginx on 8080.
# The API is not proxied here — the HTTPRoute sends /api to it directly.
# Build from the repository root: podman build -f apps/web/Containerfile .

FROM docker.io/library/node:24-alpine AS build
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/
COPY packages/contracts/package.json packages/contracts/
RUN pnpm install --frozen-lockfile --filter @eidp/web...
# The contracts' source is needed to typecheck (tsc -b), not to run.
COPY packages/contracts packages/contracts
COPY apps/web apps/web
RUN pnpm --filter @eidp/web build

FROM docker.io/nginxinc/nginx-unprivileged:1.27-alpine
COPY apps/web/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
EXPOSE 8080
