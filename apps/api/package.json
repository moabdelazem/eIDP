{
  "name": "@eidp/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch-path=src --env-file-if-exists=../../.env src/index.ts",
    "start": "node src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file-if-exists=../../.env --test 'src/**/*.test.ts'",
    "ldap:doctor": "node --env-file-if-exists=../../.env src/with-secrets.ts src/integrations/ldap/doctor.ts",
    "ado:fake": "node src/integrations/ado/fake-server.ts",
    "jira:fake": "node src/integrations/jira/fake-server.ts",
    "jenkins:fake": "node src/integrations/jenkins/fake-server.ts",
    "ollama:fake": "node src/integrations/ollama/fake-server.ts",
    "rbac:import": "node --env-file-if-exists=../../.env src/with-secrets.ts src/services/rbac-import.ts",
    "vault:fake": "node src/integrations/vault/fake-server.ts"
  },
  "dependencies": {
    "@eidp/contracts": "workspace:*",
    "@hono/node-server": "^1.13.8",
    "@hono/zod-validator": "^0.9.1",
    "hono": "^4.7.0",
    "ldapts": "^9.2.0",
    "pg": "^8.23.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "typescript": "^5.7.0"
  }
}
