member: uid=bob,ou=people,dc=eidp,dc=local
member: uid=carol,ou=people,dc=eidp,dc=local

# In no groups at all: what someone outside every team looks like. The RBAC
# tests grant and revoke on dave, so they never change what bob can do while
# the request tests run beside them.
